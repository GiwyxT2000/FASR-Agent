# Copy this file to `DeepSeek_key.env` and put your own key in it.
#
# The retrieval method described in the paper issues no LLM calls, so this file
# is not needed to reproduce any reported result. It is kept only as a template
# for extending the pipeline with LLM-assisted components.
#
# `DeepSeek_key.env` itself is listed in .gitignore and must never be committed.

DEEPSEEK_API_KEY=your_api_key_here
